<?xml version="1.0" encoding="UTF-8"?>
<!--
  Launches the portal at login and keeps it running.

  Windows has no launchd equivalent, so this leans on the app's single-instance
  lock instead: the task simply tries to start the portal every 5 minutes. If it
  is already running the new copy sees the lock and exits immediately, so the
  repeat is a no-op. If it died, the repeat brings it back.

  Import (run as Administrator, adjust the path first):
    schtasks /create /tn "DY Portal" /xml scripts\dy-portal-task.xml
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Runs the DY Portal kiosk display and restarts it if it stops.</Description>
    <URI>\DY Portal</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <Repetition>
        <Interval>PT5M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- A wall display is mains-powered; never defer or kill it over power. -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>false</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <!-- An always-on portal must never be timed out. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>5</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <!-- Default electron-builder install location. Change if you installed
           per-machine into Program Files. -->
      <Command>%LOCALAPPDATA%\Programs\DY Portal\DY Portal.exe</Command>
    </Exec>
  </Actions>
</Task>
